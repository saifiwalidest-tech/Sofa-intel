# ==============================================================================
# SOFA INTEL DZ — Environment Configuration Template
# Copyright (c) 2026 saifiwalid. All rights reserved.
# ==============================================================================

# --- Application Mode ---
APP_ENV=development
APP_NAME="SOFA INTEL DZ"
APP_COPYRIGHT="saifiwalid"
DEBUG=true
LOG_LEVEL=INFO

# --- Backend API ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-strong-random-64-char-secret-key
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_RATE_LIMIT_PER_MINUTE=120

# --- Database ---
# Local dev default uses SQLite; Production uses PostgreSQL + pgvector + PostGIS
DATABASE_URL=sqlite+aiosqlite:///./sofa_intel_dz.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://sofa_user:sofa_pass@postgres:5432/sofa_intel_dz

# --- Redis / Background Queue ---
REDIS_URL=redis://localhost:6379/0
ENABLE_CELERY=false

# --- Search Engine ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=change-this-meilisearch-key

# --- AI & LLM Providers (Optional / Pluggable) ---
# Platform works in deterministic local-intelligence mode without paid keys.
LLM_PROVIDER=local_heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
DAILY_LLM_TOKEN_BUDGET=250000

# --- Source Adapters (Authorized Access Only) ---
OUEDKNISS_ADAPTER_MODE=user_submitted_and_public_index
FACEBOOK_GRAPH_ACCESS_TOKEN=
INSTAGRAM_GRAPH_ACCESS_TOKEN=
TIKTOK_RESEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
